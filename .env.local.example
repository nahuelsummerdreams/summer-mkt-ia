# Copiar como .env.local (nunca commitear — ya está en .gitignore).
#
# AI Model Hub — todas estas claves se usan SOLO en el servidor
# (src/lib/ai/providers/*.ts y src/app/api/ai/*). Nunca les pongas el
# prefijo NEXT_PUBLIC_: eso las expondría al navegador.
#
# Completá una o varias — AUTO MODE elige entre las que estén configuradas.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Instagram (Meta Graph API) — no alcanza con pegar una key: hay que
# registrar una app en developers.facebook.com, vincular una cuenta de
# Instagram business y pasar la revisión de permisos de contenido antes
# de tener un access token válido. Ver src/lib/integrations.ts.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok (TikTok for Developers) — requiere aprobación de la Content
# Posting API. Ver src/lib/integrations.ts.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# WhatsApp (WhatsApp Business Platform / Cloud API de Meta) — registrar
# una app en developers.facebook.com con el producto WhatsApp, verificar
# un número business y generar el access token. WHATSAPP_VERIFY_TOKEN lo
# elegís vos: es el valor que Meta te pide confirmar al registrar el
# webhook /api/whatsapp/webhook. Ver src/lib/integrations.ts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Video Studio / AI Influencers — ninguno de estos tiene un adaptador
# implementado todavía (ver src/lib/ai/media-providers.ts): son los
# candidatos documentados para cuando se elija uno. Sin esto configurado,
# Video Studio genera guion + escenas igual (es todo por reglas), pero
# cada "Generar escena" queda en failed con el motivo exacto.
RUNWAY_API_KEY=
KLING_API_KEY=
KLING_API_SECRET=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
